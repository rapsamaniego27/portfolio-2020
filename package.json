{
    "name": "rap-esteva-portfolio",
    "private": true,
    "packageManager": "npm@11.19.1",
    "engines": {
        "node": ">=24.15.0 <25",
        "npm": "11.x"
    },
    "scripts": {
        "dev": "npm run development",
        "development": "webpack --config webpack.mix.js --mode development",
        "watch": "webpack --config webpack.mix.js --mode development --watch",
        "watch-poll": "webpack --config webpack.mix.js --mode development --watch --watch-options-poll=1000",
        "hot": "npm run watch",
        "prod": "npm run production",
        "production": "webpack --config webpack.mix.js --mode production",
        "check": "npm run prod && npm audit",
        "test:projects": "node --test source/tests/static-projects.test.cjs",
        "test:jekyll": "bundle exec ruby source/tests/jekyll-projects.test.rb",
        "test:local-api": "npm run test:projects"
    },
    "browserslist": [
        "defaults"
    ],
    "devDependencies": {
        "autoprefixer": "10.6.2",
        "cssnano": "9.9.0",
        "postcss": "8.5.32",
        "sass": "1.108.1",
        "terser": "5.51.2",
        "webpack": "5.112.2",
        "webpack-cli": "7.3.1"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "7.3.1",
        "gsap": "3.15.1"
    }
}
